{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kenangulol-dev",
  "compatibility_date": "2026-11-17",
  // The site is built by the dashboard build command "hugo --gc --minify",
  // with a HUGO_VERSION build variable. See KURULUM.md.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
